# Copy to .env and fill in. Never commit .env.
# Without keys every screen works and the apps answer from the rules.

# The assistant's answers (https://openrouter.ai/keys). Use a limited key made only for this.
OPENROUTER_API_KEY=
# Optional: another model than the default anthropic/claude-haiku-5.5
OPENROUTER_MODEL=

# The assistant's voice and speech to text (https://elevenlabs.io/app/settings/api-keys).
# Use a key limited to Text to Speech and Speech to Text, with a credit limit.
ELEVENLABS_API_KEY=
# Optional: a specific voice and model
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
